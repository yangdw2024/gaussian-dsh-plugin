{
  "name": "@gaussian/dsh-plugin-gaussian",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cordis plugin for Gaussian calculation assistance: input generation, output parsing, job management, BSE basis sets, Sobko knowledge base, and error diagnosis.",
  "main": "./lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "gaussian": {
    "channel": "local-debug",
    "targets": [
      "win32-x64"
    ],
    "backend": {
      "defaultUrl": "http://127.0.0.1:8765",
      "pythonEntry": "backend.app:main"
    }
  },
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch"
  }
}
