{
  "mcpServers": {
    "gaussian": {
      "command": "python",
      "args": [
        "<PATH_TO_GAUSSIAN_MCP_SERVER>/mcp_server.py"
      ],
      "env": {
        "GAUSSIAN_WORK_DIR": "<PATH_TO_YOUR_CALCULATION_DIRECTORY>",
        "GAUSSIAN_DEFAULT_MEM": "12GB",
        "GAUSSIAN_DEFAULT_NPROC": "8"
      }
    }
  }
}
