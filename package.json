{
  "name": "@gd/gp",
  "version": "0.2.0",
  "type": "module",
  "description": "DSH (DeepSeek Harness) plugin for Gaussian 16: input generation, SMILES-to-3D (RDKit), output parsing, serial job management, BSE basis sets, Multiwfn/VMD post-processing (orbital/ESP/RDG).",
  "main": "./lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib/",
    "src/",
    "backend/",
    "scripts/",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE",
    "requirements.txt"
  ],
  "keywords": [
    "dsh", "cordis", "gaussian", "computational-chemistry",
    "multiwfn", "vmd", "rdkit", "dft", "orbital", "esp", "rdg"
  ],
  "author": "yangdw2024",
  "license": "MIT",
  "homepage": "https://github.com/yangdw2024/gaussian-dsh-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangdw2024/gaussian-dsh-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/yangdw2024/gaussian-dsh-plugin/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "gaussian": {
    "channel": "local-debug",
    "targets": [
      "win32-x64"
    ],
    "backend": {
      "defaultUrl": "http://127.0.0.1:8765",
      "pythonEntry": "backend.app:main"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch"
  }
}
